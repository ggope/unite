# Supabase project (create it in the EU Frankfurt region). Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used for account deletion. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public address of the site, used in share links and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_LOGIN=off   # set to "on" after enabling Google in Supabase
CRON_SECRET=   # any long random text; Vercel sends it to /api/news/import when the daily cron runs

# Donations: Stripe Payment Links (Stripe dashboard > Payment links). Leave empty to show "opening soon".
NEXT_PUBLIC_DONATE_URL=
NEXT_PUBLIC_DONATE_MONTHLY_URL=
NEXT_PUBLIC_DONATE_CURRENCY=EUR          # currency shown on the amount buttons
NEXT_PUBLIC_DONATE_AMOUNTS=5,10,25,50,100 # suggested amounts (up to 6); "Other" is always offered
# Optional: fixed-amount links, so the payment page already shows the amount. JSON, e.g.
# {"once":{"10":"https://buy.stripe.com/..."},"monthly":{"5":"https://buy.stripe.com/..."}}
NEXT_PUBLIC_DONATE_LINKS=
# Optional: bank transfer box (shown only when the IBAN is set) and an email for larger gifts and questions.
NEXT_PUBLIC_DONATE_IBAN=
NEXT_PUBLIC_DONATE_ACCOUNT_NAME=
NEXT_PUBLIC_DONATE_BIC=
NEXT_PUBLIC_DONATE_EMAIL=

# UNIER's own email sender: signing with only an email (no account) and error alerts.
# For now a Gmail address with an app password (Google account → Security → App passwords), about 500 emails a day.
# With an own domain later: Resend (smtp.resend.com, user "resend", pass = API key) or Brevo. Same settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=   # optional, e.g. "UNIER <hello@your-domain>"; defaults to SMTP_USER
MAIL_DAILY_CAP=400   # most signing emails a day, under the mail account's own limit
ALERT_EMAIL=   # who hears when something breaks on the live site
# Recommended for update emails to many signers (0027): Brevo (EU) or Resend, through their API.
# Needs an own domain verified with the service, and MAIL_FROM set to an address on it. Used instead of SMTP when set.
BREVO_API_KEY=
RESEND_API_KEY=
MAIL_UPDATES_DAILY_CAP=   # most update emails a day; default 250 with Brevo/Resend, 100 with SMTP

# UNIER team petitions (0023): an AI helper drafts petitions from trusted news each morning; a moderator approves each one.
# Key from console.anthropic.com (set a monthly spending limit there). Leave empty to switch drafting off.
ANTHROPIC_API_KEY=
UNIER_AI_MODEL=   # optional; defaults to claude-opus-5-5
# AI check for moderation (Admin → AI check, 0024) uses the same key. Without it, everything waits for a person.
# AI_DAILY_LIMIT=200
# Automatic petition translations (0026), same key: petitions per day and model
# AI_TRANSLATE_DAILY_LIMIT=100
# AI_TRANSLATE_MODEL=claude-sonnet-5-5
# AI_MODERATION_MODEL=claude-opus-5-5
