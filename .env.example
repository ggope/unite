# Supabase project (create it in the EU Frankfurt region). Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used for account deletion. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public address of the site, used in share links and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_LOGIN=off   # set to "on" after enabling Google in Supabase
CRON_SECRET=   # any long random text; Vercel sends it to /api/news/import when the daily cron runs

# Donations: Stripe Payment Links (Stripe dashboard > Payment links). Leave empty to show "opening soon".
NEXT_PUBLIC_DONATE_URL=
NEXT_PUBLIC_DONATE_MONTHLY_URL=

# UNIER's own email sender: signing with only an email (no account) and error alerts.
# For now a Gmail address with an app password (Google account → Security → App passwords), about 500 emails a day.
# With an own domain later: Resend (smtp.resend.com, user "resend", pass = API key) or Brevo. Same settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=   # optional, e.g. "UNIER <hello@your-domain>"; defaults to SMTP_USER
MAIL_DAILY_CAP=400   # most signing emails a day, under the mail account's own limit
ALERT_EMAIL=   # who hears when something breaks on the live site

# UNIER team petitions (0023): an AI helper drafts petitions from trusted news each morning; a moderator approves each one.
# Key from console.anthropic.com (set a monthly spending limit there). Leave empty to switch drafting off.
ANTHROPIC_API_KEY=
UNIER_AI_MODEL=   # optional; defaults to claude-opus-5-5
